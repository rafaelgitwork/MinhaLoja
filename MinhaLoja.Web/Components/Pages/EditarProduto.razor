@page "/produtos/{Id:int}/editar"
@rendermode InteractiveServer
@using MinhaLoja.Shared.DTOs.Produtos
@using MinhaLoja.Shared.DTOs.Categorias
@using MinhaLoja.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject ProdutoWebService ProdutoService
@inject CategoriaWebService CategoriaService
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Funcionario,Administrador")]

<PageTitle>Editar produto | MinhaLoja</PageTitle>

<div class="page-heading"><p class="eyebrow">CATÁLOGO / EDIÇÃO</p><h1>Editar produto</h1><p>Mantenha as informações do seu produto atualizadas.</p></div>

@if (_erros.Length > 0)
{
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
            @foreach (var erro in _erros)
            {
                <li>@erro</li>
            }
        </ul>
    </div>
}

@if (_carregando)
{
    <p>Carregando produto...</p>
}
else if (_produto is not null)
{
    <EditForm class="editor-form" Model="_produto"
              OnValidSubmit="SalvarAsync"
              FormName="editar-produto">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <fieldset disabled="@_salvando">
            <div class="mb-3">
                <label for="nome" class="form-label">Nome</label>
                <InputText id="nome" class="form-control"
                           @bind-Value="_produto.Nome" />
            </div>

            <div class="mb-3">
                <label for="descricao" class="form-label">Descrição</label>
                <InputTextArea id="descricao" class="form-control"
                               @bind-Value="_produto.Descricao" />
            </div>

            <div class="mb-3">
                <label for="preco" class="form-label">Preço (R$)</label>
                <InputNumber id="preco" class="form-control"
                             step="0.01"
                             @bind-Value="_produto.Preco" />
            </div>

            <div class="mb-3">
                <label for="categoria" class="form-label">Categoria</label>
                <InputSelect id="categoria" class="form-select"
                             @bind-Value="_produto.CategoriaId">
                    <option value="0">Selecione uma categoria</option>

                    @foreach (var categoria in _categorias)
                    {
                        <option value="@categoria.Id">
                            @categoria.Nome
                        </option>
                    }
                </InputSelect>
            </div>

            <button type="submit" class="btn btn-primary">
                @(_salvando ? "Salvando..." : "Salvar alterações")
            </button>
        </fieldset>
    </EditForm>
}

<a href="/produtos" class="d-inline-block mt-3">
    Voltar para produtos
</a>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProdutoUpdateRequest? _produto;
    private List<CategoriaResponse> _categorias = new();
    private string[] _erros = Array.Empty<string>();
    private bool _carregando = true;
    private bool _salvando;

    protected override async Task OnParametersSetAsync()
    {
        _carregando = true;
        _produto = null;
        _erros = Array.Empty<string>();

        try
        {
            var produto = await ProdutoService.ObterPorIdAsync(Id);

            if (produto is null)
            {
                _erros = new[] { "Produto não encontrado ou indisponível." };
                return;
            }

            _categorias = await CategoriaService.ListarAsync();

            _produto = new ProdutoUpdateRequest
            {
                Nome = produto.Nome,
                Descricao = produto.Descricao,
                Preco = produto.Preco,
                CategoriaId = produto.CategoriaId
            };
        }
        catch (HttpRequestException)
        {
            _erros = new[] { "Não foi possível carregar os dados da edição." };
        }
        catch (TaskCanceledException)
        {
            _erros = new[] { "A consulta demorou demais. Atualize a página." };
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task SalvarAsync()
    {
        if (_salvando || _produto is null)
        {
            return;
        }

        _salvando = true;
        _erros = Array.Empty<string>();

        try
        {
            _erros = await ProdutoService.AtualizarAsync(Id, _produto);

            if (_erros.Length == 0)
            {
                Navigation.NavigateTo("/produtos");
            }
        }
        catch (HttpRequestException)
        {
            _erros = new[]
            {
                "A comunicação falhou. Confira os dados do produto antes de tentar novamente."
            };
        }
        catch (TaskCanceledException)
        {
            _erros = new[]
            {
                "O tempo de espera terminou. Confira os dados antes de tentar novamente."
            };
        }
        finally
        {
            _salvando = false;
        }
    }
}