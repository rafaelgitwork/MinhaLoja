@page "/categorias"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Funcionario,Administrador")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using MinhaLoja.Shared.DTOs.Categorias
@using MinhaLoja.Web.Services

@inject CategoriaWebService CategoriaService

<PageTitle>Categorias | MinhaLoja</PageTitle>

<h1>Categorias</h1>

<p>Cadastre, edite e gerencie a disponibilidade das categorias.</p>

@if (_sucesso is not null)
{
    <div class="alert alert-success" role="status">
        @_sucesso
    </div>
}

@if (_erro is not null)
{
    <div class="alert alert-danger" role="alert">
        @_erro

        @if (_precisaLogin)
        {
            <a href="/login"
               data-enhance-nav="false"
               class="alert-link ms-2">
                Entrar novamente
            </a>
        }
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">
            @(_editandoId.HasValue ? "Editar categoria" : "Nova categoria")
        </h2>

        <EditForm Model="_dados"
                  OnValidSubmit="PrepararSalvarAsync"
                  FormName="gestao-categoria">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <fieldset disabled="@(Ocupado || _envioIncerto || _confirmarInativacao)">
                <div class="mb-3">
                    <label for="nome-categoria" class="form-label">
                        Nome
                    </label>

                    <InputText id="nome-categoria"
                               class="form-control"
                               maxlength="100"
                               @bind-Value="_dados.Nome" />

                    <ValidationMessage For="@(() => _dados.Nome)" />
                </div>

                @if (_editandoId.HasValue)
                {
                    <div class="form-check mb-3">
                        <InputCheckbox id="categoria-ativa"
                                       class="form-check-input"
                                       @bind-Value="_ativa" />

                        <label for="categoria-ativa"
                               class="form-check-label">
                            Categoria ativa
                        </label>
                    </div>

                    <p class="text-muted">
                        Categorias inativas e seus produtos deixam de aparecer
                        no catálogo online. Pedidos anteriores são preservados.
                    </p>
                }

                <button type="submit"
                        class="btn btn-primary"
                        disabled="@_precisaLogin">
                    @(_salvando ? "Salvando..." :
                        _editandoId.HasValue ? "Salvar alterações" : "Cadastrar")
                </button>

                @if (_editandoId.HasValue)
                {
                    <button type="button"
                            class="btn btn-outline-secondary ms-2"
                            @onclick="CancelarEdicao">
                        Cancelar edição
                    </button>
                }
            </fieldset>
        </EditForm>
    </div>
</div>

@if (_confirmarInativacao)
{
    <div class="alert alert-warning" role="alert">
        <p>
            Deseja inativar esta categoria?
            Seus produtos ficarão indisponíveis no catálogo online.
        </p>

        <button type="button"
                class="btn btn-danger"
                disabled="@Ocupado"
                @onclick="SalvarAsync">
            Confirmar inativação
        </button>

        <button type="button"
                class="btn btn-outline-secondary ms-2"
                disabled="@Ocupado"
                @onclick="VoltarDaConfirmacao">
            Voltar
        </button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">Categorias cadastradas</h2>

    <button type="button"
            class="btn btn-outline-secondary"
            disabled="@Ocupado"
            @onclick="AtualizarAsync">
        Atualizar lista
    </button>
</div>

@if (_carregando)
{
    <p>Carregando categorias...</p>
}
else if (_categorias is null)
{
    <p>A listagem está indisponível. Tente atualizar.</p>
}
else if (_categorias.Count == 0)
{
    <p>Nenhuma categoria cadastrada.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var categoria in _categorias)
                {
                    <tr @key="categoria.Id">
                        <td>@categoria.Id</td>
                        <td>@categoria.Nome</td>
                        <td>
                            <span class="@(categoria.Ativa
                                                                ? "badge bg-success"
                                                                : "badge bg-secondary")">
                                @(categoria.Ativa ? "Ativa" : "Inativa")
                            </span>
                        </td>
                        <td>
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm"
                                    disabled="@(Ocupado || _envioIncerto || _confirmarInativacao)"
                                    @onclick="() => Editar(categoria)">
                                Editar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_envioIncerto && _categorias is not null && !Ocupado)
{
    <div class="alert alert-warning">
        Confira o resultado na lista antes de realizar outra alteração.

        <button type="button"
                class="btn btn-outline-dark btn-sm ms-2"
                @onclick="LiberarFormulario">
            Já conferi a lista
        </button>
    </div>
}

@code {
    private CategoriaCreateRequest _dados = new();
    private List<CategoriaResponse>? _categorias;

    private int? _editandoId;
    private bool _ativa = true;
    private bool _ativaOriginal = true;

    private bool _carregando;
    private bool _salvando;
    private bool _precisaLogin;
    private bool _envioIncerto;
    private bool _confirmarInativacao;

    private string? _erro;
    private string? _sucesso;

    private bool Ocupado => _carregando || _salvando;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private void Editar(CategoriaResponse categoria)
    {
        if (Ocupado || _envioIncerto || _confirmarInativacao)
            return;

        _erro = null;
        _sucesso = null;

        _editandoId = categoria.Id;
        _ativa = categoria.Ativa;
        _ativaOriginal = categoria.Ativa;

        _dados = new CategoriaCreateRequest
        {
            Nome = categoria.Nome
        };
    }

    private void LimparFormulario()
    {
        _dados = new CategoriaCreateRequest();
        _editandoId = null;
        _ativa = true;
        _ativaOriginal = true;
        _confirmarInativacao = false;
    }

    private void CancelarEdicao()
    {
        if (Ocupado)
            return;

        LimparFormulario();
        _erro = null;
        _sucesso = null;
    }

    private void VoltarDaConfirmacao()
    {
        _confirmarInativacao = false;
    }

    private async Task AtualizarAsync()
    {
        if (Ocupado)
            return;

        _erro = null;
        _sucesso = null;
        LimparFormulario();

        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;

        try
        {
            _categorias = await CategoriaService.ListarGestaoAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            _categorias = null;
            _precisaLogin = true;
            _erro = ex.Message;
        }
        catch (HttpRequestException)
        {
            _categorias = null;
            _erro = "Não foi possível carregar as categorias. Confira a API.";
        }
        catch (TaskCanceledException)
        {
            _categorias = null;
            _erro = "A consulta demorou demais. Tente atualizar.";
        }
        catch (System.Text.Json.JsonException)
        {
            _categorias = null;
            _erro = "A API retornou dados em formato inesperado.";
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task PrepararSalvarAsync()
    {
        if (Ocupado || _envioIncerto || _precisaLogin)
            return;

        _erro = null;
        _sucesso = null;

        if (string.IsNullOrWhiteSpace(_dados.Nome))
        {
            _erro = "Informe o nome da categoria.";
            return;
        }

        if (_editandoId.HasValue && _ativaOriginal && !_ativa)
        {
            _confirmarInativacao = true;
            return;
        }

        await SalvarAsync();
    }

    private async Task SalvarAsync()
    {
        if (Ocupado || _envioIncerto || _precisaLogin)
            return;

        _salvando = true;
        _erro = null;
        _sucesso = null;

        var nome = _dados.Nome.Trim();
        var editando = _editandoId.HasValue;

        try
        {
            string? erro;

            if (_editandoId is int id)
            {
                erro = await CategoriaService.AtualizarAsync(
                    id,
                    new CategoriaUpdateRequest
                    {
                        Nome = nome,
                        Ativa = _ativa
                    });
            }
            else
            {
                erro = await CategoriaService.CriarAsync(
                    new CategoriaCreateRequest
                    {
                        Nome = nome
                    });
            }

            _confirmarInativacao = false;

            if (erro is not null)
            {
                _erro = erro;
                return;
            }

            LimparFormulario();

            _sucesso = editando
                ? $"Categoria “{nome}” atualizada."
                : $"Categoria “{nome}” cadastrada.";

            await CarregarAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            _confirmarInativacao = false;
            _precisaLogin = true;
            _erro = ex.Message;
        }
        catch (HttpRequestException)
        {
            RegistrarEnvioIncerto();
        }
        catch (TaskCanceledException)
        {
            RegistrarEnvioIncerto();
        }
        finally
        {
            _salvando = false;
        }
    }

    private void RegistrarEnvioIncerto()
    {
        _confirmarInativacao = false;
        _envioIncerto = true;
        _categorias = null;

        _erro =
            "Não foi possível confirmar a gravação. Atualize a lista " +
            "e confira o resultado antes de tentar novamente.";
    }

    private void LiberarFormulario()
    {
        _envioIncerto = false;
        _erro = null;
        LimparFormulario();
    }
}