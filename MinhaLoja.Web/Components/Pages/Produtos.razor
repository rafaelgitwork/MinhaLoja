@using Microsoft.AspNetCore.Components.Authorization
@page "/produtos"
@using MinhaLoja.Shared.DTOs.Produtos
@using MinhaLoja.Web.Services
@using System.Globalization
@inject ProdutoWebService ProdutoService

<PageTitle>Produtos | MinhaLoja</PageTitle>

<h1>Produtos</h1>

<AuthorizeView>
    <Authorized Context="sessao">
        <p>
            Conectado como:
            <strong>@sessao.User.Identity?.Name</strong>

            <a href="/sair"
               data-enhance-nav="false"
               class="ms-3">
                Sair
            </a>
        </p>
    </Authorized>

    <NotAuthorized>
        <p>
            Você não está conectado.
            <a href="/login" data-enhance-nav="false">
                Entrar no painel
            </a>
        </p>
    </NotAuthorized>
</AuthorizeView>

<AuthorizeView Roles="Funcionario,Administrador">
    <a href="/produtos/novo" class="btn btn-primary mb-3">
        Novo produto
    </a>
</AuthorizeView>

@if (_erro is not null)
{
    <div class="alert alert-danger" role="alert">
        @_erro
    </div>
}
else if (_produtos is null)
{
    <p>Carregando produtos...</p>
}
else if (_produtos.Count == 0)
{
    <p>Nenhum produto disponível.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Ações</th>
            </tr>
        </thead>
<tbody>
    @foreach (var produto in _produtos)
    {
        <tr>
            <td>@produto.Nome</td>

            <td>
                @produto.Preco.ToString("C2", CulturaBrasileira)
            </td>

            <td>@produto.QuantidadeEstoque</td>

            <td>
                <AuthorizeView Roles="Funcionario,Administrador">
                    <Authorized>
                        <a href="@($"/produtos/{produto.Id}/editar")"
                           class="btn btn-outline-primary btn-sm">
                            Editar
                        </a>
                        <a href="@($"/produtos/{produto.Id}/estoque")"
                           class="btn btn-outline-success btn-sm ms-2">
                           Repor estoque
                       </a>
                    </Authorized>

                    <NotAuthorized>
                        <span class="text-muted">Sem permissão</span>
                    </NotAuthorized>
                </AuthorizeView>
            </td>
        </tr>
    }
</tbody>
    </table>
}

@code {
    private static readonly CultureInfo CulturaBrasileira =
        CultureInfo.GetCultureInfo("pt-BR");

    private List<ProdutoResponse>? _produtos;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _produtos = await ProdutoService.ListarAsync();
        }
        catch (HttpRequestException)
        {
            _erro = "Não foi possível carregar os produtos. Verifique se a API está rodando.";
        }
        catch (TaskCanceledException)
        {
            _erro = "A consulta demorou demais. Atualize a página para tentar novamente.";
        }
    }
}