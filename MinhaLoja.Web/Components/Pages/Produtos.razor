@using Microsoft.AspNetCore.Components.Authorization
@page "/produtos"
@using MinhaLoja.Shared.DTOs.Produtos
@using MinhaLoja.Web.Services
@using System.Globalization
@inject ProdutoWebService ProdutoService

<PageTitle>Produtos | MinhaLoja</PageTitle>

<div class="page-heading heading-actions"><div><p class="eyebrow">CATÁLOGO DA LOJA</p><h1>Produtos</h1><p>Todos os seus produtos, com preço e estoque à vista.</p></div>
<AuthorizeView Roles="Funcionario,Administrador"><a href="/produtos/novo" class="btn btn-primary">+ Novo produto</a></AuthorizeView></div>

@if (_erro is not null)
{
    <div class="alert alert-danger" role="alert">
        @_erro
    </div>
}
else if (_produtos is null)
{
    <p>Carregando produtos...</p>
}
else if (_produtos.Count == 0)
{
    <p>Nenhum produto disponível.</p>
}
else
{
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Ações</th>
            </tr>
        </thead>
<tbody>
    @foreach (var produto in _produtos)
    {
        <tr>
            <td><span class="product-name">@produto.Nome</span><span class="product-code">Produto #@produto.Id</span></td>

            <td>
                @produto.Preco.ToString("C2", CulturaBrasileira)
            </td>

            <td><span class="@(produto.QuantidadeEstoque > 0 ? "stock-pill" : "stock-pill empty")">@produto.QuantidadeEstoque unidades</span></td>

            <td>
                <AuthorizeView Roles="Funcionario,Administrador">
                    <Authorized>
                        <a href="@($"/produtos/{produto.Id}/editar")"
                           class="btn btn-outline-primary btn-sm">
                            Editar
                        </a>
                        <a href="@($"/produtos/{produto.Id}/estoque")"
                           class="btn btn-outline-success btn-sm ms-2">
                           Repor estoque
                       </a>
                    </Authorized>

                    <NotAuthorized>
                        <span class="text-muted">Sem permissão</span>
                    </NotAuthorized>
                </AuthorizeView>
            </td>
        </tr>
    }
</tbody>
    </table></div>
}

@code {
    private static readonly CultureInfo CulturaBrasileira =
        CultureInfo.GetCultureInfo("pt-BR");

    private List<ProdutoResponse>? _produtos;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _produtos = await ProdutoService.ListarAsync();
        }
        catch (HttpRequestException)
        {
            _erro = "Não foi possível carregar os produtos. Verifique se a API está rodando.";
        }
        catch (TaskCanceledException)
        {
            _erro = "A consulta demorou demais. Atualize a página para tentar novamente.";
        }
    }
}