<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:produtos="clr-namespace:MinhaLoja.Shared.DTOs.Produtos;assembly=MinhaLoja.Shared"
    x:Class="MinhaLoja.Mobile.MainPage"
    Title="Produtos">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="16">

        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">

            <VerticalStackLayout Spacing="4">
                <Label Text="MinhaLoja"
                       FontSize="28"
                       FontAttributes="Bold" />

                <Label Text="Confira nossos produtos."
                       FontSize="14" />
            </VerticalStackLayout>

            <Button x:Name="AtualizarButton"
                    Grid.Column="1"
                    Text="Atualizar"
                    VerticalOptions="Center"
                    Clicked="OnAtualizarClicked" />
        </Grid>

        <ActivityIndicator x:Name="CarregandoIndicator"
                           Grid.Row="1"
                           IsRunning="False"
                           IsVisible="False"
                           HorizontalOptions="Center" />

        <Label x:Name="ErroLabel"
               Grid.Row="2"
               TextColor="Red"
               IsVisible="False" />

        <CollectionView x:Name="ProdutosCollection"
                        Grid.Row="3"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label x:Name="VazioLabel"
                       Text="Aguardando consulta..."
                       Margin="0,20"
                       HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="produtos:ProdutoResponse">
                    <Border Padding="16"
                            Stroke="#D1D5DB"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Nome}"
                                   FontSize="20"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding Descricao}"
                                   FontSize="14" />

                            <Label Text="{Binding Preco, StringFormat='Preço: R$ {0:N2}'}"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding QuantidadeEstoque, StringFormat='Estoque: {0} unidades'}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>