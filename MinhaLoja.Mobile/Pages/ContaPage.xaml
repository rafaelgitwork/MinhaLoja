<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MinhaLoja.Mobile.Pages.ContaPage"
    Title="Minha conta">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="16"
                             MaximumWidthRequest="500"
                             HorizontalOptions="Fill">

            <Label Text="Minha conta"
                   FontSize="28"
                   FontAttributes="Bold" />

            <ActivityIndicator x:Name="CarregandoIndicator"
                               IsVisible="False"
                               IsRunning="False" />

            <Label x:Name="MensagemLabel"
                   IsVisible="False" />

            <VerticalStackLayout x:Name="LoginLayout"
                                 Spacing="12">

                <Label Text="Entre para comprar e acompanhar seus pedidos." />

                <Label Text="E-mail" />

                <Entry x:Name="EmailEntry"
                       Placeholder="seuemail@exemplo.com"
                       Keyboard="Email"
                       MaxLength="254"
                       IsTextPredictionEnabled="False"
                       IsSpellCheckEnabled="False" />

                <Label Text="Senha" />

                <Entry x:Name="SenhaEntry"
                       Placeholder="Digite sua senha"
                       IsPassword="True"
                       MaxLength="128" />

                <Button Text="Entrar"
                        Clicked="OnEntrarClicked" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="SessaoLayout"
                                 IsVisible="False"
                                 Spacing="12">

                <Label Text="Você está conectado como:"
                       FontSize="16" />

                <Label x:Name="NomeLabel"
                       FontSize="22"
                       FontAttributes="Bold" />

                <Label x:Name="EmailUsuarioLabel" />

                <Button Text="Sair da conta"
                        Clicked="OnSairClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>